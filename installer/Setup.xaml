<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="960" Height="640" MinWidth="820" MinHeight="580" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize" Background="#101011" Foreground="#EEE5D8" Title="Instalação do DeadVox" FontFamily="Segoe UI" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EEE5D8"/><Setter Property="Background" Value="#171718"/><Setter Property="BorderBrush" Value="#6D665C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22,12"/><Setter Property="FontSize" Value="16"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.58"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFF0D7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DEDAD2"/><Setter Property="FontSize" Value="16"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,0,17"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="24" Height="24" Background="#191819" BorderBrush="#76645C" BorderThickness="1" CornerRadius="2"><Path x:Name="Tick" Data="M 4,11 L 9,16 L 20,5" Stroke="#FFF0DF" StrokeThickness="2.4" Visibility="Collapsed"/></Border><ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#A32925"/><Setter TargetName="Box" Property="BorderBrush" Value="#BA4D3C"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FFF0D7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border BorderBrush="#4C4139" BorderThickness="1"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" BorderBrush="#3C322B" BorderThickness="0,0,0,1" Background="#131314"><Grid><TextBlock Text="Instalação do DeadVox" Margin="18,0" VerticalAlignment="Center" Foreground="#BDB2A4" FontSize="14"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Minimize" Content="&#x2014;" Padding="17,5" BorderThickness="0" FontSize="18"/><Button x:Name="Close" Content="&#x00D7;" Padding="17,5" BorderThickness="0" FontSize="23"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="29.5*"/><ColumnDefinition Width="70.5*"/></Grid.ColumnDefinitions>
   <Border BorderBrush="#4C3027" BorderThickness="0,0,1,0"><Grid ClipToBounds="True">
    <Grid.Background><RadialGradientBrush Center="0.5,0.43" GradientOrigin="0.5,0.43" RadiusX="0.85" RadiusY="0.85"><GradientStop Color="#29201B" Offset="0"/><GradientStop Color="#121112" Offset="1"/></RadialGradientBrush></Grid.Background>
    <Rectangle Opacity="0.10"><Rectangle.Fill><DrawingBrush TileMode="Tile" Viewport="0,0,9,9" ViewportUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="#C1966D"><GeometryDrawing.Geometry><RectangleGeometry Rect="1,2,1,1"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Rectangle.Fill></Rectangle>
    <Canvas HorizontalAlignment="Center" Width="282" Opacity="0.45" IsHitTestVisible="False"><Line X1="141" Y1="0" X2="141" Y2="640" Stroke="#9A4B35"/><Line X1="0" Y1="210" X2="282" Y2="210" Stroke="#9A4B35"/><Ellipse Canvas.Left="24" Canvas.Top="100" Width="234" Height="234" Stroke="#9A4B35"/><Ellipse Canvas.Left="89" Canvas.Top="37" Width="104" Height="104" Stroke="#683E2E"/><Ellipse Canvas.Left="85" Canvas.Top="433" Width="112" Height="112" Stroke="#683E2E"/><Path Data="M141,27 L147,35 L141,43 L135,35 Z M16,210 L22,202 L28,210 L22,218 Z M254,210 L260,202 L266,210 L260,218 Z M141,440 L147,448 L141,456 L135,448 Z" Stroke="#DA7550"/></Canvas>
    <StackPanel VerticalAlignment="Center" Margin="15,-55,15,0"><Image x:Name="Emblem" Width="162" Height="162" Stretch="Uniform" Margin="0,0,0,8"><Image.OpacityMask><RadialGradientBrush><GradientStop Color="Black" Offset="0.65"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush></Image.OpacityMask></Image><Image x:Name="Wordmark" Height="80" Stretch="Uniform"/></StackPanel>
    <TextBlock Text="WINDOWS  /  BETA" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,27" Foreground="#8C7767" FontSize="10"/>
   </Grid></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
    <Grid x:Name="Page" Margin="48,44,44,25"><Grid.RenderTransform><TranslateTransform x:Name="PageOffset"/></Grid.RenderTransform>
     <StackPanel x:Name="Welcome"><TextBlock Text="Boas-vindas ao" FontFamily="Georgia" FontSize="25" Foreground="#C0B4A5" Margin="0,15,0,5"/><TextBlock Text="DeadVox" FontFamily="Georgia" FontSize="56" Margin="-2,0,0,24"/><TextBlock Text="Experimente Deadlock no seu idioma." FontSize="20" Foreground="#D2CEC7" TextWrapping="Wrap"/><TextBlock Text="Instale o launcher para baixar, gerenciar e aproveitar os pacotes de voz da comunidade em português." FontSize="16" Foreground="#A59F97" TextWrapping="Wrap" LineHeight="26" Margin="0,20,0,0"/><TextBlock Text="Sua próxima partida. Uma voz familiar." Foreground="#8E7666" FontFamily="Georgia" FontStyle="Italic" FontSize="16" Margin="0,35,0,0"/></StackPanel>
     <StackPanel x:Name="Destination" Visibility="Collapsed"><TextBlock Text="Instalar DeadVox" FontFamily="Georgia" FontSize="39" Margin="-1,5,0,8"/><TextBlock Text="Escolha onde instalar o launcher." FontSize="17" Foreground="#C5C2BB"/><TextBlock Text="Local de instalação" FontSize="16" Margin="0,35,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><Border Background="#121213" BorderBrush="#665C51" BorderThickness="1" CornerRadius="2" Margin="0,0,12,0"><TextBox x:Name="Location" Background="Transparent" BorderThickness="0" Foreground="#EEE5D8" CaretBrush="#EEE5D8" Padding="12,13" FontSize="14" VerticalContentAlignment="Center"/></Border><Button x:Name="Browse" Grid.Column="1" Content="Alterar..." Padding="10,10" FontFamily="Georgia"/></Grid><CheckBox x:Name="Shortcut" IsChecked="True" Content="Criar atalho na área de trabalho" Margin="0,28,0,17"/><CheckBox x:Name="Launch" IsChecked="True" Content="Abrir DeadVox ao terminar"/><TextBlock Text="Os pacotes de voz são gerenciados no launcher." Foreground="#918A80" FontSize="14" Margin="0,14,0,0"/><TextBlock x:Name="Validation" Foreground="#E18C73" TextWrapping="Wrap" FontSize="13" Margin="0,12,0,0"/></StackPanel>
     <StackPanel x:Name="Progress" Visibility="Collapsed"><TextBlock Text="Instalando DeadVox" FontFamily="Georgia" FontSize="37" Margin="0,10,0,18"/><TextBlock Text="Uma nova voz para sua próxima partida." FontSize="17" Foreground="#C5C2BB"/><Grid Width="66" Height="66" HorizontalAlignment="Left" Margin="0,44,0,28"><Ellipse Stroke="#332F29" StrokeThickness="3"/><Path x:Name="Spinner" Data="M33,2 A31,31 0 0 1 64,33" Stroke="#B6543C" StrokeThickness="3" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform/></Path.RenderTransform></Path></Grid><TextBlock x:Name="ProgressText" Text="Preparando a instalação..." Foreground="#DED6CA" FontSize="17" TextWrapping="Wrap"/><TextBlock Text="A instalação verifica o WebView2 e instala o launcher. Isso pode levar alguns minutos." FontSize="14" Foreground="#918A80" TextWrapping="Wrap" LineHeight="23" Margin="0,16,0,0"/></StackPanel>
     <StackPanel x:Name="Complete" Visibility="Collapsed"><TextBlock Text="Pronto para sua" FontFamily="Georgia" FontSize="35" Margin="0,15,0,0"/><TextBlock Text="próxima partida." FontFamily="Georgia" FontSize="45" Margin="0,0,0,25"/><TextBlock Text="DeadVox foi instalado." Foreground="#B8C7AA" FontSize="20"/><TextBlock Text="Abra o launcher para baixar os pacotes de voz disponíveis e escolher o idioma das vozes." FontSize="16" Foreground="#B6ADA1" TextWrapping="Wrap" LineHeight="26" Margin="0,20,0,0"/></StackPanel>
     <StackPanel x:Name="Failure" Visibility="Collapsed"><TextBlock Text="Vamos tentar de novo" FontFamily="Georgia" FontSize="38" Margin="0,20,0,25"/><TextBlock x:Name="ErrorText" FontSize="16" Foreground="#D9AC97" TextWrapping="Wrap" LineHeight="26"/></StackPanel>
    </Grid>
    <Border Grid.Row="1" BorderBrush="#352E28" BorderThickness="0,1,0,0"><Grid Margin="26,0,25,0"><TextBlock x:Name="Footer" Text="deadvox.com" VerticalAlignment="Center" Foreground="#817A71" FontSize="12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="Back" Content="Voltar" Width="105" Margin="0,0,14,0" Visibility="Collapsed"/><Button x:Name="Next" Content="Instalar" Width="151" Background="#435D43" BorderBrush="#7D9270" FontFamily="Georgia" FontSize="21" Padding="15,12"/></StackPanel></Grid></Border>
   </Grid>
  </Grid>
 </Grid></Border>
</Window>

